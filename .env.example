# ── CSR 모듈 (Neon) ─────────────────────────────────────────────────────────
# 비밀값이 아닙니다 — 공개 엔드포인트이고 실제 접근 통제는 JWT + RLS 가 합니다.
# 값이 비면 /csr 화면이 조회를 시도하지 않고 "설정 필요" 안내를 띄웁니다.
VITE_CSR_DATA_API_URL=
VITE_CSR_AUTH_URL=

# Apps Script 업로드 프록시 (캡쳐 첨부) — Phase 3 후반
VITE_CSR_UPLOAD_URL=
# (선택) Apps Script 스크립트 속성 CSR_UPLOAD_TOKEN 과 같은 값 — 없으면 토큰 검사 없음
VITE_CSR_UPLOAD_TOKEN=
